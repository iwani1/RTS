# Environment configuration example
# Copy to .env and adjust.
#
# DATABASE_URL is required in production. Without it the platform runs on
# PGlite — a real PostgreSQL engine compiled to WebAssembly, executing the
# same migrations in-process. That is how the demo boots with no server to
# install. PGlite is single-process: only one process may open the directory.

# --- Database ---------------------------------------------------------------
# Production:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Local fallback (used when DATABASE_URL is empty). The data lives next to the
# project in .data/pgdata and survives a rebuild. PGlite is single-process:
# only one process may open this directory at a time.
# PGLITE_DATA_DIR=.data/pgdata
# DATABASE_POOL_MAX=10

# --- Application ------------------------------------------------------------
# Public base URL. Used for the OIDC redirect URI, e-mail links and the
# absolute links printed in exported documents.
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_NAME=StaffRide
# NODE_ENV=production
# Seed the demonstration dataset on server start (set to false in production
# if the database is provisioned separately).
# SEED_ON_BOOT=false

# --- Background jobs --------------------------------------------------------
# Set to false to switch the scheduled job runner off entirely (the worker
# then never claims a job, and /operations shows it as stopped).
# JOBS_ENABLED=true
# How often the runner claims due jobs, in milliseconds.
# JOB_POLL_INTERVAL_MS=30000

# --- Backups ----------------------------------------------------------------
# Directory the scheduled backup job writes into. Created on demand.
# BACKUP_DIR=.data/backups
# How many backup archives to keep before the oldest is pruned.
# BACKUP_RETAIN=7

# --- Optional: mapping provider (falls back to the in-app demo vector map) ---
# NEXT_PUBLIC_MAP_PROVIDER=mapbox
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxx
# MAPBOX_DIRECTIONS_TOKEN=pk.xxxxx

# --- Optional: single sign-on (OIDC / SAML via an identity provider) ---------
# With no values set, the SSO buttons are hidden and the sign-in page falls
# back to email and password only. The OIDC flow is a real authorization-code
# exchange with PKCE; it is only "demo mode" in the sense that no real
# identity provider is configured here.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=staffride
# OIDC_CLIENT_SECRET=xxxxx
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# --- Optional: SMS (phone OTP sign-in) --------------------------------------
# Without these the OTP screen still works: codes are generated, hashed and
# verified in the database, but the message is only written to the server log
# and the delivery is recorded as "simulated". Never enable in production
# without a real gateway.
# SMS_PROVIDER=hubtel
# SMS_PROVIDER_API_KEY=xxxxx
# SMS_PROVIDER_SENDER_ID=StaffRide

# --- Optional: e-mail (notifications, invoices, password reset) ------------
# Without these the notification fan-out records the message with a delivery
# status of "simulated" and writes the body to the server log.
# EMAIL_PROVIDER=ses
# EMAIL_PROVIDER_API_KEY=xxxxx
# EMAIL_FROM=transport@example.com

# --- Optional: push notifications (driver and passenger PWA) ----------------
# Without these, push notifications are recorded as "simulated" and are not
# delivered to a device.
# PUSH_PROVIDER=web-push
# PUSH_PROVIDER_API_KEY=xxxxx
# PUSH_VAPID_PUBLIC_KEY=xxxxx
# PUSH_VAPID_PRIVATE_KEY=xxxxx

# --- Optional: payments (interfaces only until configured) ------------------
# PAYSTACK_SECRET_KEY=sk_test_xxxxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
# FLUTTERWAVE_SECRET_KEY=flw_test_xxxxx

# --- Optional: the address the server binds to -------------------------------
# The production server listens on every interface by default, so a phone or a
# second machine on the same network can reach it. Set BIND_HOST to narrow it
# to one address, for example 127.0.0.1 to keep it on this machine only.
# BIND_HOST=0.0.0.0
# PORT=3000

# --- Optional: local network access ------------------------------------------
# Extra origins the server-action CSRF check and the dev server accept, as a
# comma-separated list. A LAN address already works without this, because the
# browser's Origin then matches the host the request arrived on. Set it when
# the app sits behind a reverse proxy that rewrites the Host header.
# In development it is read when the server starts; in a production build it
# is compiled in, so set it before `npm run build`.
# SERVER_ACTION_ALLOWED_ORIGINS=192.168.1.42,my-host.local

# --- Optional: the session cookie --------------------------------------------
# The session cookie is marked Secure when the request arrived over https
# (a proxy that reports x-forwarded-proto: https), and not marked Secure
# over plain http, because a browser only keeps a Secure cookie on a
# trusted origin. A LAN address over plain http therefore keeps working.
# Set this to force the attribute either way.
# SESSION_COOKIE_SECURE=false

# --- Optional: observability ------------------------------------------------
# Log level for the JSON logger: debug | info | warn | error
# LOG_LEVEL=info
# When set, every request also writes a line to this file in addition to
# stdout (useful for shipping logs off the box).
# LOG_FILE=.data/logs/app.log
# Expose the Prometheus metrics endpoint without a session. Only ever do this
# behind a private network or an authenticating proxy.
# METRICS_PUBLIC=false

# --- Optional: test harness ------------------------------------------------
# Enables POST /api/test/session so an automated smoke test can obtain a
# session without a browser. The route returns 404 unless this value is set
# and the same value is presented in the x-test-token header. Never set it in
# production.
# The automated test harness. The token signs in as any account, so it is
# closed unless it is explicitly enabled.
# TEST_SESSION_ENABLED=true
# TEST_SESSION_TOKEN=change-me
