    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "12.23.24",
    "lucide-react": "0.545.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
